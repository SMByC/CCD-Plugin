              <number>3</number>
             </property>
             <item row="0" column="0">
              <widget class="QLabel" name="label_4">
               <property name="sizePolicy">
                <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
                 <horstretch>0</horstretch>
                 <verstretch>0</verstretch>
                </sizepolicy>
               </property>
               <property name="text">
                <string>Bands/Indices for Change Detection</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignmentFlag::AlignCenter</set>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QgsCheckableComboBox" name="box_breakpoint_bands">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Bands and indices whose residuals drive change detection. Each is measured against its own RMSE and they are combined into the statistic tested against Chi-square.&lt;/p&gt;&lt;p&gt;Default &lt;b&gt;Green, Red, NIR, SWIR1, SWIR2&lt;/b&gt;. Blue is left out because it carries the most residual haze and aerosol signal, a well known source of false breaks.&lt;/p&gt;&lt;p&gt;Green and SWIR1 are also the TMask bands, which Earth Engine requires to be change-detection bands, so they are added back automatically if you deselect them.&lt;/p&gt;&lt;p&gt;Note: Regenerate to apply the changes.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="editable">
                <bool>true</bool>
               </property>
               <property name="sizeAdjustPolicy">
                <enum>QComboBox::SizeAdjustPolicy::AdjustToContents</enum>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
          <item>
           <widget class="QWidget" name="widget_2" native="true">
