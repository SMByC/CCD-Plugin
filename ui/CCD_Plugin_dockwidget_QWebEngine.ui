               <property name="cursor">
                <cursorShape>PointingHandCursor</cursorShape>
               </property>
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Open the current plot in a web browser, for a bigger view.&lt;/p&gt;&lt;p&gt;Saving the plot as a PNG works there, which it does not inside the plugin.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="icon">
