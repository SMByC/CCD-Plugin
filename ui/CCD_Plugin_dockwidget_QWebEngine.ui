             <item row="1" column="1">
              <widget class="QDateEdit" name="end_date">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;Last date to include in the series.&lt;/p&gt;&lt;p&gt;A range that ends before the selected dataset began returns no images at all, which is the usual surprise with Sentinel-2. The plugin names the dataset's availability window when that happens.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="calendarPopup">
                <bool>true</bool>
               </property>
              </widget>
             </item>
             <item row="0" column="0" colspan="2">
              <widget class="QLabel" name="label">
               <property name="text">
                <string>Date Range</string>
               </property>
               <property name="alignment">
                <set>Qt::AlignmentFlag::AlignCenter</set>
               </property>
              </widget>
             </item>
             <item row="1" column="0">
              <widget class="QDateEdit" name="start_date">
               <property name="toolTip">
                <string>&lt;html&gt;&lt;head/&gt;&lt;body&gt;&lt;p&gt;First date to include in the series.&lt;/p&gt;&lt;p&gt;Earlier than the dataset's first year is harmless: the series simply starts when the data does.&lt;/p&gt;&lt;/body&gt;&lt;/html&gt;</string>
               </property>
               <property name="dateTime">
                <datetime>
                 <hour>10</hour>
                 <minute>0</minute>
                 <second>0</second>
                 <year>2010</year>
                 <month>1</month>
                 <day>1</day>
                </datetime>
               </property>
               <property name="calendarPopup">
                <bool>true</bool>
               </property>
              </widget>
             </item>
            </layout>
           </widget>
          </item>
